# 当前运行环境：development | test | production
NODE_ENV=development
# 服务监听主机地址；本地开发可用 127.0.0.1，容器部署建议 0.0.0.0
HOST=0.0.0.0
# 服务监听端口；本地默认可用 3000
PORT=3000

# Chatwoot 服务基础地址（不带末尾斜杠），例如 http://127.0.0.1:3000
CHATWOOT_BASE_URL=http://127.0.0.1:3000
# Agent Bot 的 API Access Token（从 Chatwoot Agent Bot 页面获取访问令牌）
CHATWOOT_BOT_API_ACCESS_TOKEN=replace_with_real_token
# 是否开启 Webhook 签名校验（MVP 阶段建议先关闭）
VERIFY_SIGNATURE=false

# 微服务启动主机地址
MICRO_HOST=0.0.0.0
# 微服务监听端口
MICRO_PORT=3001

# ========================================
# Login System: PostgreSQL
# ========================================
# 本地开发 PostgreSQL 连接串
DATABASE_URL="postgresql://postgres:123456@127.0.0.1:5433/agent_nestjs?schema=public"

# ========================================
# Login System: Redis
# ========================================
# 本地开发 Redis 连接串（无密码）
# REDIS_URL="redis://127.0.0.1:6379"
# 本地开发 Redis 连接串（有密码）
REDIS_URL="redis://:123456@127.0.0.1:6379"

# ========================================
# Login System: JWT / Auth
# ========================================
# Access Token 签名密钥
JWT_ACCESS_SECRET="change_me_access_secret"
# Refresh Token 签名密钥
JWT_REFRESH_SECRET="change_me_refresh_secret"
# Access Token 过期时间
JWT_ACCESS_EXPIRES_IN="24h"
# Refresh Token 过期时间
JWT_REFRESH_EXPIRES_IN="7d"

# 注册时是否强制要求手机号
AUTH_REGISTER_REQUIRE_PHONE=false
# 连续登录失败达到多少次后冻结账号
AUTH_LOGIN_FAIL_LIMIT="10"cang
# 登录账号冻结时长（小时）
AUTH_LOGIN_FREEZE_HOURS="24"
# 审计日志保留天数
AUDIT_LOG_RETENTION_DAYS="7"
# 登录历史保留天数
LOGIN_HISTORY_RETENTION_DAYS="15"
# 管理员强制下线后的默认前端提示文案
ADMIN_FORCE_LOGOUT_MESSAGE="用户信息已过期，请重新登录！"

# 初始化管理员默认用户名
INIT_ADMIN_USERNAME="Admin"
# 初始化管理员默认密码
INIT_ADMIN_PASSWORD="Aa123456"

# 可选的密码附加 Pepper
PASSWORD_PEPPER="cPIbS+R&bHxOnu%&Ct*UABiAesLxQ1*$+FZrGac6m3rHX6~bF0&-NTGiVI/f/J2l"

# ========================================
# Login System: Swagger
# ========================================
# 是否启用 Swagger 文档
SWAGGER_ENABLE=true
